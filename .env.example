# App
# Port the web app listens on. Defaults to 3000. If you change it, change
# NEXTAUTH_URL to match — otherwise sign-in redirects point at a port with
# nothing on it, and the failure shows up far from its cause.
# PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Worker
# The daily jobs (token refresh, next-reel binding, follower snapshots) run
# inside the worker, so no platform cron is needed. Set to false only if an
# external scheduler calls the /api/cron/* routes instead, or every job runs
# twice a day.
# WORKER_SCHEDULES_ENABLED=true

# Login
# How many reverse proxies sit in front of the app. The login rate limiter reads
# the client IP that many entries from the right of x-forwarded-for, because
# anything further left can be forged by the caller. 1 covers Vercel and a
# single nginx/Caddy/Traefik; use 2 behind Cloudflare plus your own proxy, and 0
# if nothing rewrites the header.
TRUSTED_PROXY_HOPS=1

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: host ports for the local docker-compose services. Change these if
# something else already listens on the defaults — DATABASE_URL and REDIS_URL
# above have to point at the same ports. They are bound to localhost only.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Optional: hostname of the tunnel you use for local development, so Next
# accepts dev requests coming through it (see next.config.ts).
# DEV_TUNNEL_HOST=your-tunnel.ngrok-free.dev
