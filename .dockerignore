# Kept out of the build context: things the image regenerates, things that only
# slow the upload down, and one thing that must never get in.

node_modules
.next
.git
.github
.gstack
.vscode
.idea

# .env is gitignored but it does sit in the working tree. Without this line a
# local `docker build` bakes development secrets into the image.
.env*

# Regenerated by `prisma generate` during the build.
/app/generated

coverage
__tests__
*.tsbuildinfo
*.log

docs
*.md

Dockerfile
.dockerignore
docker-compose.yml
